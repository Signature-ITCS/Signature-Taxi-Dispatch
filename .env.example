# ─────────────────────────────────────────────────────────────────────────────
# Dispatch platform — environment variables (Vercel → Settings → Environment
# Variables). Only PLATFORM-wide values live here. Each company's own keys
# (its Stripe, Resend, Cosmic SMS) are entered by that company in Admin →
# Settings and stored encrypted in the database; the platform's own Stripe and
# Resend keys are entered in the master dashboard → Platform settings.
# Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Project Settings → API) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Bypasses row-level security — server only.
SUPABASE_SERVICE_ROLE_KEY=

# ── Encryption of stored keys ────────────────────────────────────────────────
# SECRET. 32 random bytes, base64. Encrypts every API key/password saved in the
# database. Generate once:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy in a password manager: if it is lost, every saved key must be
# entered again. Never change it once keys are saved.
SECRETS_ENCRYPTION_KEY=

# ── The platform's address ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://booking.airport-transfer.uk

# ── Google Maps (address search + routes for every company) ──────────────────
# SECRET. Server-side only. Enable Places API (New) and Routes API; restrict the
# key by API, not by website.
GOOGLE_MAPS_API_KEY=

# ── Daily cron (vercel.json) ─────────────────────────────────────────────────
# SECRET. Any long random string. Vercel sends it to /api/cron/keepalive.
CRON_SECRET=

# ── Push notifications to drivers (Web Push / VAPID) ─────────────────────────
# One key pair for the whole platform:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Optional fallbacks (used only until set in the master dashboard) ─────────
# The platform's own Stripe (companies' subscriptions) and Resend (welcome and
# password emails). Prefer the master dashboard; these are read if it is empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Dispatch Platform <noreply@your-domain.co.uk>

# Cloudflare Turnstile ("are you human?" check on sign-up, sign-in, forgot
# password and partner applications). Optional: leave empty to switch it off.
# Cloudflare dashboard → Turnstile → Add widget (domain booking.airport-transfer.uk).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
